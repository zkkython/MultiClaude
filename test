class MockOutputCollector:
    """简化版 RequestOutputCollector"""
    def __init__(self):
        self.output: Optional[MockRequestOutput] = None
        self.ready = asyncio.Event()
    
    def put(self, output):
        if self.output is None:
            self.output = output
            self.ready.set()
        else:
