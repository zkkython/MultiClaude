### 代码示例

以下代码演示 DEALER/ROUTER 和 PUSH/PULL 的基本用法：

```python
"""
演示 vLLM 中使用的两种 ZMQ 通信模式
"""
import zmq
import threading
import time

def demo_dealer_router():
    """DEALER/ROUTER 模式：多引擎 -> 前端"""
    ctx = zmq.Context()
    
    # 前端：ROUTER socket（类似 vLLM 的 MPClient.input_socket）
    router = ctx.socket(zmq.ROUTER)
    router.bind("tcp://127.0.0.1:5555")
    
    def engine_worker(engine_id: int):
        """模拟 EngineCore 进程"""
        dealer = ctx.socket(zmq.DEALER)
        # 设置 identity，类似 vLLM 中 engine_index.to_bytes(...)
        dealer.identity = engine_id.to_bytes(2, byteorder="little")
        dealer.connect("tcp://127.0.0.1:5555")
        
        # 发送消息（类似 EngineCore 的 startup_handshake）
        dealer.send_string(f"HELLO from engine {engine_id}")
        time.sleep(0.1)
        dealer.close()
    
    # 启动两个 "引擎"
    for i in range(2):
        threading.Thread(target=engine_worker, args=(i,)).start()
    
    # 前端接收消息
    for _ in range(2):
        identity, message = router.recv_multipart()
        engine_id = int.from_bytes(identity, byteorder="little")
        print(f"[ROUTER] 收到来自 engine {engine_id} 的消息: {message.decode()}")
    
    router.close()
    ctx.term()

def demo_push_pull():
    """PUSH/PULL 模式：引擎 -> 前端单向推送"""
    ctx = zmq.Context()
    
    # 前端：PULL socket（类似 vLLM 的 output_socket）
    pull = ctx.socket(zmq.PULL)
    pull.bind("tcp://127.0.0.1:5556")
    
    def producer():
        """模拟 EngineCore 的 output socket 线程"""
        push = ctx.socket(zmq.PUSH)
        push.connect("tcp://127.0.0.1:5556")
        for i in range(3):
            push.send_string(f"Output batch {i}")
            time.sleep(0.05)
        push.close()
    
    threading.Thread(target=producer).start()
    
    for _ in range(3):
        msg = pull.recv_string()
        print(f"[PULL] 收到: {msg}")
    
    pull.close()
    ctx.term()

if __name__ == "__main__":
    print("=== DEALER/ROUTER Demo ===")
    demo_dealer_router()
    print("\n=== PUSH/PULL Demo ===")
    demo_push_pull()
```

